{
	"name": "newswires",
	"version": "1.0.0",
	"description": "Newswires feed app",
	"workspaces": [
		"cdk",
		"shared",
		"ingestion-lambda",
		"cleanup-lambda",
		"poller-lambdas",
		"newswires/client",
		"email-filter-lambda",
		"fingerpost-queueing-lambda",
		"recomputation-lambda"
	],
	"scripts": {
		"test": "lage test",
		"test:ci": "npm run test --workspaces --if-present",
		"synth": "npm run synth --workspace=cdk",
		"typecheck": "lage typecheck",
		"typecheck:ci": "npm run typecheck --workspaces",
		"build": "lage build",
		"build:ci": "npm run build --workspaces",
		"lint": "lage lint",
		"lint:ci": "npm run lint:ci --workspaces",
		"pre-commit-checks": "lage precommit",
		"dev": "npm run dev --workspaces --if-present",
		"storybook": "npm run storybook --workspace=newswires/client",
		"prepare": "husky"
	},
	"repository": {
		"type": "git",
		"url": "github.com/guardian/newswires"
	},
	"devDependencies": {
		"@guardian/eslint-config": "16.0.0",
		"@guardian/prettier": "11.0.0",
		"@guardian/tsconfig": "2.0.0",
		"@types/node": "22.15.35",
		"@typescript-eslint/parser": "^8.49.0",
		"esbuild": "^0.28.1",
		"eslint": "10.7.0",
		"eslint-plugin-prettier": "5.5.6",
		"husky": "^9.1.7",
		"lage": "^2.15.17",
		"prettier": "3.9.6",
		"tsx": "^4.23.9",
		"typescript": "5.9.3",
		"vite": "8.1.4",
		"vitest": "4.1.10"
	},
	"prettier": "@guardian/prettier",
	"overrides": {
		"eslint": "10.7.0",
		"fast-xml-parser": "5.5.8",
		"nanoid": "^5.0.9",
		"nodemailer": "9.0.3",
		"undici": "^7.29.0"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1104.0",
		"@guardian/libs": "^33.0.0",
		"@sentry/react": "^10.69.0",
		"@types/aws-lambda": "8.10.162",
		"mailauth": "^4.13.3",
		"node-html-parser": "9.0.0",
		"zod": "4.4.3"
	}
}
